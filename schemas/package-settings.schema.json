{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "title": "Package Settings",

    "type": "object",

    "additionalProperties": false,

    "properties": {

        "userConfigurable": {
            "type": "boolean"
        },

        "settings": {

            "type": "array",

            "items": {

                "type": "object",

                "required": [
                    "id",
                    "type",
                    "default"
                ],

                "properties": {

                    "id": {
                        "type": "string"
                    },

                    "displayName": {
                        "type": "string"
                    },

                    "description": {
                        "type": "string"
                    },

                    "type": {
                        "type": "string",
                        "enum": [
                            "boolean",
                            "integer",
                            "decimal",
                            "string",
                            "path",
                            "choice"
                        ]
                    },

                    "default": {},

                    "choices": {
                        "type": "array"
                    }
                }
            }
        }
    }
}
