{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Code Desk Repository Catalog 1.0",
  "type": "object",
  "required": [
    "formatVersion",
    "repositoryId",
    "repositoryName",
    "catalogVersion",
    "generatedAt",
    "minimumCodeDeskVersion",
    "packages"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "repositoryId": {
      "type": "string"
    },
    "repositoryName": {
      "type": "string"
    },
    "catalogVersion": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimumCodeDeskVersion": {
      "type": "string"
    },
    "termsUrl": {
      "type": "string"
    },
    "packages": {
      "type": "array"
    }
  }
}
