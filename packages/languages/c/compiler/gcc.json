{
  "formatVersion": 1,
  "id": "gcc",
  "displayName": "GNU C Compiler / Clang C",
  "executableCandidates": ["gcc", "gcc.exe", "clang", "clang.exe"],
  "versionArguments": ["--version"],
  "discoveryEnvironmentVariables": ["CC", "LLVM_HOME", "MINGW_HOME", "MSYS2_ROOT"],
  "discoveryRelativeExecutablePaths": ["bin/gcc", "bin/gcc.exe", "bin/clang", "bin/clang.exe"],
  "discoverySearchRoots": {
    "windows": ["%ProgramFiles%/LLVM", "%ProgramFiles(x86)%/LLVM", "%ProgramData%/chocolatey/bin", "%USERPROFILE%/scoop/apps", "C:/msys64", "C:/MinGW", "C:/mingw64"],
    "linux": ["/usr", "/usr/local", "/opt"],
    "macos": ["/usr/local", "/opt/homebrew", "/opt/local", "/Library/Developer/CommandLineTools/usr"]
  },
  "sourceExtensions": [".c"],
  "headerExtensions": [".h"],
  "libraryExtensions": [".a", ".so", ".dylib", ".lib"],
  "defaultTarget": "c17",
  "artifactType": "native-executable",
  "requiresExternalToolchain": true,
  "projectInformationFile": ".codedesk/project.pinf",
  "buildArguments": ["-std=${target}", "-Wall", "-Wextra", "${sources}", "-o", "${artifactDirectory}/${artifactName}${executableSuffix}"],
  "artifactCandidates": ["${artifactDirectory}/${artifactName}${executableSuffix}"],
  "runArguments": [],
  "diagnosticFormat": "gcc"
}
