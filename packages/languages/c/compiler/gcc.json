{
  "formatVersion": 1,
  "id": "gcc",
  "displayName": "GNU C Compiler / Clang C",
  "executableCandidates": ["gcc", "gcc.exe", "clang", "clang.exe"],
  "versionArguments": ["--version"],
  "sourceExtensions": [".c"],
  "headerExtensions": [".h"],
  "libraryExtensions": [".a", ".so", ".dylib", ".lib"],
  "defaultTarget": "c17",
  "artifactType": "native-executable",
  "requiresExternalToolchain": true,
  "projectInformationFile": ".codedesk/project.pinf",
  "buildArguments": ["-std=${target}", "-Wall", "-Wextra", "${sources}", "-o", "${artifactDirectory}/${artifactName}${executableSuffix}"],
  "artifactCandidates": ["${artifactDirectory}/${artifactName}${executableSuffix}"],
  "runArguments": [],
  "diagnosticFormat": "gcc"
}
