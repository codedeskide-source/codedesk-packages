{
  "formatVersion": 1,
  "id": "dotnet",
  "displayName": ".NET SDK",
  "executableCandidates": ["dotnet", "dotnet.exe"],
  "versionArguments": ["--version"],
  "sourceExtensions": [".cs"],
  "defaultTarget": "net8.0",
  "artifactType": "dotnet-application",
  "windowsGuiArtifactType": "dotnet-windows-application",
  "windowsGuiOutputType": "WinExe",
  "windowsGuiArtifactExtension": ".exe",
  "requiresExternalToolchain": true,
  "projectInformationFile": ".codedesk/project.pinf",
  "generatedFiles": {
    ".codedesk-build/package/CodeDesk.Generated.csproj": "<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>${outputType}</OutputType>\n    <TargetFramework>${target}</TargetFramework>\n    <AssemblyName>${artifactName}</AssemblyName>\n    <Version>${version}</Version>\n    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>\n    <ImplicitUsings>enable</ImplicitUsings>\n    <Nullable>enable</Nullable>\n${platformProperties}  </PropertyGroup>\n  <ItemGroup>\n${sourceItems}  </ItemGroup>\n</Project>\n"
  },
  "profiles": {
    "dotnet-application": {
      "outputType": "Exe",
      "platformProperties": ""
    },
    "dotnet-windows-application": {
      "target": "net8.0-windows",
      "outputType": "WinExe",
      "platformProperties": "    <EnableWindowsTargeting>true</EnableWindowsTargeting>\n    <UseWindowsForms>true</UseWindowsForms>\n"
    }
  },
  "repeatedSourceTemplate": "    <Compile Include=\"${sourceXml}\" />\n",
  "buildArguments": ["publish", "${generatedProject}", "--configuration", "Release", "--output", "${artifactDirectory}", "--self-contained", "false"],
  "artifactCandidates": ["${artifactDirectory}/${artifactName}.dll", "${artifactDirectory}/${artifactName}.exe"],
  "runArguments": ["${artifact}"],
  "diagnosticFormat": "msbuild"
}
