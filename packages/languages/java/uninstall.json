{
  "formatVersion": 1,
  "removeInstalledFiles": true,
  "removeEmptyDirectories": true,
  "removeConfiguration": false,
  "rollbackOnFailure": true,
  "preUninstallTasks": [
    {
      "task": "disable-package",
      "required": true,
      "arguments": {
        "packageId": "codedesk.language.java"
      }
    },
    {
      "task": "close-package-resources",
      "required": true,
      "arguments": {
        "packageId": "codedesk.language.java"
      }
    }
  ],
  "postUninstallTasks": [
    {
      "task": "reload-languages",
      "required": true,
      "arguments": {
        "languageId": "java"
      }
    },
    {
      "task": "refresh-package-index",
      "required": true,
      "arguments": {}
    }
  ]
}
