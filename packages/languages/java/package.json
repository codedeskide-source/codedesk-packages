{
    "$schema": "../../../schemas/package-manifest.schema.json",

    "id": "codedesk.language.java",
    "name": "java-language",
    "displayName": "Java Language Support",

    "version": "1.0.0",
    "type": "language",
    "publisher": "Code Desk",

    "description": "Official Java language support package for Code Desk, including file recognition, syntax configuration, autocomplete data, compiler configuration, templates, and documentation.",

    "homepage": "https://github.com/codedeskide-source/codedesk-packages",

    "license": "Code Desk Official Package License",

    "minimumCodeDeskVersion": "0.1.3",

    "language": {
        "id": "java",
        "displayName": "Java",
        "extensions": [
            ".java"
        ],
        "fileNames": [
            "module-info.java",
            "package-info.java"
        ],
        "syntaxId": "text/java",
        "defaultEncoding": "UTF-8"
    },

    "dependencies": [],

    "files": [
        {
            "source": "language/java-language.json",
            "destination": "languages/java/java-language.json",
            "sha256": ""
        },
        {
            "source": "autocomplete/java-keywords.json",
            "destination": "languages/java/autocomplete/java-keywords.json",
            "sha256": ""
        },
        {
            "source": "compiler/javac.json",
            "destination": "languages/java/compiler/javac.json",
            "sha256": ""
        },
        {
            "source": "templates/Class.java",
            "destination": "languages/java/templates/Class.java",
            "sha256": ""
        },
        {
            "source": "templates/Interface.java",
            "destination": "languages/java/templates/Interface.java",
            "sha256": ""
        },
        {
            "source": "templates/Enum.java",
            "destination": "languages/java/templates/Enum.java",
            "sha256": ""
        },
        {
            "source": "templates/MainClass.java",
            "destination": "languages/java/templates/MainClass.java",
            "sha256": ""
        },
        {
            "source": "documentation/java-package-readme.txt",
            "destination": "languages/java/documentation/java-package-readme.txt",
            "sha256": ""
        }
    ]
}
