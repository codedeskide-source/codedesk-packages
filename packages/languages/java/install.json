{
  "formatVersion": 1,
  "installMode": "copy",
  "overwriteExisting": true,
  "verifyChecksums": true,
  "createDirectories": true,
  "rollbackOnFailure": true,
  "requiresRestart": false,
  "postInstallTasks": [
    {
      "task": "reload-languages",
      "required": true,
      "arguments": {
        "languageId": "java17"
      }
    },
    {
      "task": "reload-autocomplete",
      "required": true,
      "arguments": {
        "languageId": "java17"
      }
    },
    {
      "task": "reload-templates",
      "required": true,
      "arguments": {
        "languageId": "java17"
      }
    },
    {
      "task": "reload-compilers",
      "required": true,
      "arguments": {
        "compilerId": "javac"
      }
    },
    {
      "task": "refresh-package-index",
      "required": true,
      "arguments": {}
    }
  ]
}
